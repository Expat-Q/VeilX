# ==============================================================================
# XTip / VeilX — Production Environment Configuration Template
# All secret values below are PLACEHOLDERS. NEVER commit live secrets or keys.
# ==============================================================================

# Database Configuration (MongoDB Atlas or standalone replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/xtip?retryWrites=true&w=majority

# Session Security (AES-256-GCM authenticated encryption)
# CRITICAL: Must be a random, cryptographically secure string of at least 32 characters in production.
# Generate via: openssl rand -base64 32
SESSION_SECRET=replace_with_a_secure_random_at_least_32_characters_secret_key!

# Automated Sync & Maintenance Protection
# Bearer token required to invoke /api/sync endpoint for expired tip sweeps and reconciliation
# Generate via: openssl rand -hex 24
CRON_SECRET=replace_with_random_cron_worker_secret_token

# X (Twitter) OAuth 2.0 PKCE Application Credentials
TWITTER_CLIENT_ID=your_x_oauth2_client_id
TWITTER_CLIENT_SECRET=your_x_oauth2_client_secret
TWITTER_CALLBACK_URL=https://veilxapp.onrender.com/api/auth/callback/twitter
TWITTER_BEARER_TOKEN=optional_x_bearer_token

# Zcash Node & Wallet RPC Configuration (Zallet / zcashd / zebrad / lightwalletd)
ZALLET_RPC_URL=http://127.0.0.1:18232
ZALLET_RPC_USER=xtip_rpc_user
ZALLET_RPC_PASS=replace_with_strong_rpc_password

# Target Zcash Network ('testnet' or 'mainnet')
NEXT_PUBLIC_ZCASH_NETWORK=mainnet

# Public Application URL (used for OAuth redirects and canonical links)
NEXT_PUBLIC_APP_URL=https://veilxapp.onrender.com

# Production Simulation Guard
# CRITICAL: In production (NODE_ENV=production), simulation is strictly prohibited and fails closed.
# Set to 'false' in all staging and production environments.
ENABLE_TESTNET_SIMULATION=false
